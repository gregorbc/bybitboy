<?xml version="1.0"?>
<ruleset name="BinanceBot">
    <description>Binance Bot coding standard based on PSR-12</description>
    <rule ref="PSR12"/>
    <config name="tabWidth" value="4"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <file>.</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>coverage/*</exclude-pattern>
    <exclude-pattern>vendor/**/*</exclude-pattern>
    <exclude-pattern>tests/**/*</exclude-pattern>
    <exclude-pattern>coverage/**/*</exclude-pattern>
    <rule ref="PSR12.ControlStructures.ControlSignature">
        <properties>
            <property name="inlineControlStructures" value="true"/>
        </properties>
    </rule>
    <rule ref="PSR12.Classes.ClassInstantiation">
        <properties>
            <property name="ignoreNewlines" value="false"/>
        </properties>
    </rule>
</ruleset>