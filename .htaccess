# Web Security Hardening — Grid Bot
Options -Indexes

# Bloquear archivos sensibles (defensa en profundidad tras nginx).
# Patrón por extensión en medio del nombre: cubre .bak.20260724_202823,
# .backup.20260613_031040, config.json.safe, *.pkl, *.pid, keystore, etc.
<FilesMatch "\.(json|bak|backup|safe|sql|log|env|conf|dist|lock|key|pem|pkl|pid|properties|keystore|old|orig)(\.|_|$)">
    Require all denied
</FilesMatch>

<FilesMatch "^(install\.php|install_hestia\.php|test_config\.php)$">
    Require all denied
</FilesMatch>
