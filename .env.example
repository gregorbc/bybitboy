# Bybit Grid Bot - Environment Variables
# Copy this file to .env and fill in your values

# MySQL
MYSQL_PASSWORD=Enladisco123@
MYSQL_ROOT_PASSWORD=rootpass

# Bybit API (testnet)
BYBIT_API_KEY=your_api_key
BYBIT_API_SECRET=your_api_secret
BYBIT_TESTNET=true

# Bot Config
SYMBOL=ETHUSDT
CAPITAL_USD=30
LEVERAGE=100
TIMEFRAME=5

# ML
ML_WEIGHTS_FILE=ml_weights_v2.json
ML_MIN_CONFIDENCE=45

# NVIDIA (optional)
NV_API_KEY=
NV_ENABLED=false
NV_INTERVAL_SEC=480

# Alerts (optional)
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=